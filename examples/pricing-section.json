{
  "name": "Pricing",
  "layout": "column",
  "w": 1200,
  "padding": [80, 64],
  "gap": 48,
  "align": "center",
  "fill": "#FFFFFF",
  "children": [
    {
      "name": "Header",
      "layout": "column",
      "gap": 12,
      "align": "center",
      "children": [
        { "name": "Eyebrow", "text": "Pricing", "size": 14, "weight": 600, "color": "#4F46E5", "case": "upper", "letterSpacing": "8%" },
        { "name": "Title", "text": "Plans that grow with you", "size": 44, "weight": 700, "lineHeight": 52, "letterSpacing": -1 },
        { "name": "Subtitle", "text": "Start free, upgrade when your team needs more.", "size": 18, "color": "#6B7280" }
      ]
    },
    {
      "name": "Plans",
      "layout": "grid",
      "columns": ["1fr", "1fr", "1fr"],
      "gap": 24,
      "w": "fill",
      "children": [
        {
          "name": "Plan card",
          "layout": "column",
          "w": "fill",
          "padding": 32,
          "gap": 20,
          "radius": 16,
          "stroke": "#E5E7EB",
          "children": [
            { "name": "Plan", "text": "Starter", "size": 20, "weight": 600 },
            { "name": "Price", "spans": [{ "text": "$0", "size": 40, "weight": 700 }, { "text": " / month", "color": "#6B7280" }] },
            { "name": "Description", "text": "For side projects and trying things out.", "color": "#6B7280", "w": "fill" },
            {
              "name": "Features",
              "layout": "column",
              "gap": 10,
              "children": [
                { "name": "Feature", "layout": "row", "gap": 8, "align": "center", "children": [{ "icon": "lucide:check", "size": 16, "color": "#16A34A" }, { "text": "3 projects" }] },
                { "name": "Feature", "layout": "row", "gap": 8, "align": "center", "children": [{ "icon": "lucide:check", "size": 16, "color": "#16A34A" }, { "text": "Community support" }] }
              ]
            },
            { "name": "Button", "layout": "row", "justify": "center", "w": "fill", "padding": [12, 20], "radius": 10, "stroke": "#D1D5DB", "children": [{ "text": "Get started", "weight": 600 }] }
          ]
        },
        {
          "name": "Plan card featured",
          "layout": "column",
          "w": "fill",
          "padding": 32,
          "gap": 20,
          "radius": 16,
          "fill": { "gradient": ["#4F46E5", "#7C3AED"], "angle": 135 },
          "shadow": { "y": 12, "blur": 32, "color": "#4F46E540" },
          "children": [
            { "name": "Badge", "layout": "row", "padding": [4, 10], "radius": 999, "fill": "#FFFFFF33", "children": [{ "text": "Most popular", "size": 12, "weight": 600, "color": "#FFFFFF" }] },
            { "name": "Plan", "text": "Pro", "size": 20, "weight": 600, "color": "#FFFFFF" },
            { "name": "Price", "spans": [{ "text": "$29", "size": 40, "weight": 700, "color": "#FFFFFF" }, { "text": " / month", "color": "#E0E7FF" }] },
            { "name": "Description", "text": "For teams shipping every week.", "color": "#E0E7FF", "w": "fill" },
            {
              "name": "Features",
              "layout": "column",
              "gap": 10,
              "children": [
                { "name": "Feature", "layout": "row", "gap": 8, "align": "center", "children": [{ "icon": "lucide:check", "size": 16, "color": "#FFFFFF" }, { "text": "Unlimited projects", "color": "#FFFFFF" }] },
                { "name": "Feature", "layout": "row", "gap": 8, "align": "center", "children": [{ "icon": "lucide:check", "size": 16, "color": "#FFFFFF" }, { "text": "Priority support", "color": "#FFFFFF" }] }
              ]
            },
            { "name": "Button", "layout": "row", "justify": "center", "w": "fill", "padding": [12, 20], "radius": 10, "fill": "#FFFFFF", "children": [{ "text": "Start free trial", "weight": 600, "color": "#4F46E5" }] }
          ]
        },
        {
          "name": "Plan card",
          "layout": "column",
          "w": "fill",
          "padding": 32,
          "gap": 20,
          "radius": 16,
          "stroke": "#E5E7EB",
          "children": [
            { "name": "Plan", "text": "Enterprise", "size": 20, "weight": 600 },
            { "name": "Price", "text": "Custom", "size": 40, "weight": 700 },
            { "name": "Description", "text": "SSO, audit logs and a dedicated contact.", "color": "#6B7280", "w": "fill" },
            {
              "name": "Features",
              "layout": "column",
              "gap": 10,
              "children": [
                { "name": "Feature", "layout": "row", "gap": 8, "align": "center", "children": [{ "icon": "lucide:check", "size": 16, "color": "#16A34A" }, { "text": "SAML SSO" }] },
                { "name": "Feature", "layout": "row", "gap": 8, "align": "center", "children": [{ "icon": "lucide:check", "size": 16, "color": "#16A34A" }, { "text": "99.9% uptime SLA" }] }
              ]
            },
            { "name": "Button", "layout": "row", "justify": "center", "w": "fill", "padding": [12, 20], "radius": 10, "fill": "#111827", "children": [{ "text": "Contact sales", "weight": 600, "color": "#FFFFFF" }] }
          ]
        }
      ]
    }
  ]
}
